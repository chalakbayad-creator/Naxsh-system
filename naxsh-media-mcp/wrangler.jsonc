{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naxsh-media-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "590b8210167b78f8cd709ca6b2f771a0",
  // Free storage (no payment method needed). To use R2 instead, add an r2_buckets binding named FILES.
  "kv_namespaces": [{ "binding": "STORE", "id": "959337ede20a4f8fab5df3ffc8548743" }],
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "JOBS", "class_name": "Jobs" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Jobs"] }],
  "vars": {
    "ADMIN_USERS": "akar",
    "DAILY_IMAGE_LIMIT": "60",
    "DAILY_TRANSCRIBE_LIMIT": "40",
    "DEFAULT_IMAGE_MODEL": "2.5-sunburst",
    "GEMINI_MODEL": "gemini-4-argon",
    "GEMINI_FALLBACK_MODELS": "gemini-4-carbon,gemini-4-hydrogen,gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.5-flash",
    "GEMINI_TRANSCRIBE_MODEL": "gemini-3.5-transcribe",
    "ART_DIRECTOR_MODELS": "gpt-5.6-sol,gpt-5.5,gpt-5.4",
    "MAX_UPLOAD_MB": "25",
    "CREDITS_PER_USD": "200"
  }
  // Secrets (never put them here): KIE_API_KEY, GEMINI_API_KEY, ACCESS_TOKENS, SIGNING_SECRET
  // npx wrangler secret put KIE_API_KEY
}
