{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naxsh-media-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "naxsh-media-files" }],
  "observability": { "enabled": true },
  "vars": {
    "ADMIN_USERS": "akar",
    "DAILY_IMAGE_LIMIT": "60",
    "DAILY_TRANSCRIBE_LIMIT": "40",
    "DEFAULT_IMAGE_MODEL": "2.5-sunburst",
    "GEMINI_MODEL": "gemini-3.1-pro-preview",
    "GEMINI_TRANSCRIBE_MODEL": "gemini-3.5-transcribe",
    "MAX_UPLOAD_MB": "200"
  }
  // Secrets (never put them here): KIE_API_KEY, GEMINI_API_KEY, ACCESS_TOKENS, SIGNING_SECRET
  // npx wrangler secret put KIE_API_KEY
}
